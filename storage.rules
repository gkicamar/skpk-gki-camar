rules_version = '2';

// Berkas lampiran LPJ: foto nota, kuitansi, dan dokumentasi kegiatan.
// Disimpan per badan pelayanan supaya izinnya bisa dipisah.

service firebase.storage {
  match /b/{bucket}/o {

    function masuk() { return request.auth != null; }

    function akun() {
      return firestore.get(/databases/(default)/documents/pengguna/$(request.auth.uid)).data;
    }

    function aktif() { return masuk() && akun().aktif == true; }
    function peran() { return aktif() ? akun().peran : 'tamu'; }
    function bpSaya() { return aktif() && akun().bp is list ? akun().bp : []; }

    function majelis() {
      return peran() in ['super', 'ketua', 'bendahara', 'pembina'];
    }

    function berkasSah() {
      return request.resource.size < 2 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }

    // Induk divisi sebuah badan pelayanan, agar kewenangan pembina menurun
    // ke departemen di bawahnya seperti pada aturan Firestore.
    function indukBP(kode) {
      return firestore.exists(/databases/(default)/documents/badanPelayanan/$(kode))
        ? firestore.get(/databases/(default)/documents/badanPelayanan/$(kode)).data.get('divisi', '')
        : '';
    }

    function binaan(kode) {
      return kode in bpSaya() || indukBP(kode) in bpSaya();
    }

    match /lampiran/{bp}/{berkas} {
      allow read: if peran() in ['super', 'ketua', 'bendahara']
                  || (peran() == 'pembina' && binaan(bp))
                  || (peran() == 'pengurus' && bp in bpSaya());

      // Bendahara dan ketua mengunggah bukti pencairan dan pelunasan;
      // pengurus mengunggah nota dan bukti pengembalian miliknya sendiri.
      allow write: if berkasSah()
                   && (peran() in ['super', 'bendahara', 'ketua']
                       || (peran() == 'pembina' && binaan(bp))
                       || (peran() == 'pengurus' && bp in bpSaya()));

      allow delete: if peran() == 'super'
                    || (peran() == 'pengurus' && bp in bpSaya());
    }

    match /{semua=**} {
      allow read, write: if false;
    }
  }
}
