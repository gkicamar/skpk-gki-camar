rules_version = '2';

// Aturan keamanan Sistem Keuangan dan Program Kerja GKI Camar.
// Satu proyek Firebase untuk satu gereja, jadi tidak ada pemisahan antar gereja di sini.
// Yang dijaga adalah pemisahan antar peran, terutama agar pengurus badan pelayanan
// tidak bisa melihat posisi keuangan gereja.

service cloud.firestore {
  match /databases/{database}/documents {

    /* ─────────── Pembantu ─────────── */

    function masuk() {
      return request.auth != null;
    }

    function akun() {
      return get(/databases/$(database)/documents/pengguna/$(request.auth.uid)).data;
    }

    function punyaAkun() {
      return masuk() && exists(/databases/$(database)/documents/pengguna/$(request.auth.uid));
    }

    function aktif() {
      return punyaAkun() && akun().aktif == true;
    }

    function peran() {
      return aktif() ? akun().peran : 'tamu';
    }

    function bpSaya() {
      return aktif() && akun().bp is list ? akun().bp : [];
    }

    function isSuper()     { return peran() == 'super'; }
    function isKetua()     { return peran() == 'ketua'; }
    function isBendahara() { return peran() == 'bendahara'; }
    function isPembina()   { return peran() == 'pembina'; }
    function isPengurus()  { return peran() == 'pengurus'; }

    // Majelis Jemaat dalam arti luas: boleh melihat seluruh isi aplikasi,
    // termasuk posisi keuangan gereja.
    function majelis() {
      return isSuper() || isKetua() || isBendahara() || isPembina();
    }

    // Peran pusat melihat seluruh gereja tanpa kecuali, termasuk data
    // yang ditandai rahasia seperti remunerasi dan JKH.
    function pusat() {
      return isSuper() || isKetua() || isBendahara();
    }

    // Tanda rahasia dibaca langsung dari data induk badan pelayanan,
    // bukan dari salinan di dokumen, supaya tidak pernah basi.
    function rahasiaBP(kode) {
      return exists(/databases/$(database)/documents/badanPelayanan/$(kode))
        && get(/databases/$(database)/documents/badanPelayanan/$(kode)).data.get('rahasia', false) == true;
    }

    // Induk divisi sebuah badan pelayanan, kosong bila ia sendiri sebuah divisi.
    function indukBP(kode) {
      return exists(/databases/$(database)/documents/badanPelayanan/$(kode))
        ? get(/databases/$(database)/documents/badanPelayanan/$(kode)).data.get('divisi', '')
        : '';
    }

    // Kewenangan menurun dari divisi ke departemen di bawahnya. Pembina yang
    // ditugaskan pada sebuah divisi otomatis membina seluruh departemennya,
    // sesuai kedudukan Majelis Jemaat sebagai otoritas badan pelayanan.
    function binaan(kode) {
      return kode in bpSaya() || indukBP(kode) in bpSaya();
    }

    // Boleh membuka dokumen milik badan pelayanan tertentu.
    function bolehLihat(kode) {
      return pusat() || binaan(kode) || !rahasiaBP(kode);
    }

    // Badan pelayanan yang menjadi tanggung jawab pengguna ini,
    // baik sebagai pengurus maupun sebagai pembina.
    function bpSendiri(kode) {
      return kode in bpSaya();
    }

    function tidakUbahPeran() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['peran', 'aktif', 'bp']);
    }

    /* ─────────── Pengguna ─────────── */
    // Hanya super user yang boleh membuat, mengubah peran, dan menonaktifkan akun.
    // Pengguna lain hanya boleh memperbarui nama dan nomor telepon dirinya sendiri.

    match /pengguna/{uid} {
      allow read: if masuk() && (request.auth.uid == uid || majelis());
      allow create, delete: if isSuper();
      allow update: if isSuper()
                    || (request.auth.uid == uid && aktif() && tidakUbahPeran());
    }

    /* ─────────── Pengaturan gereja dan data induk ─────────── */
    // Semua pengguna aktif boleh membaca, karena nama badan pelayanan
    // dan kategori dibutuhkan di hampir setiap layar.

    match /pengaturan/{dok} {
      allow read: if aktif();
      allow write: if isSuper();
    }

    match /badanPelayanan/{kode} {
      allow read: if aktif();
      allow write: if isSuper();
    }

    match /kategoriPenerimaan/{id} {
      allow read: if aktif();
      allow write: if isSuper() || isBendahara();
    }

    /* ─────────── Rekening dan dana ─────────── */
    // Ini bagian dari posisi keuangan gereja, jadi pengurus tidak diberi akses.

    match /akunKas/{kode} {
      allow read: if majelis();
      allow write: if isSuper();
    }

    match /dana/{kode} {
      allow read: if majelis();
      allow write: if isSuper() || isBendahara();
    }

    /* ─────────── Program kerja ─────────── */
    // Semua pengguna aktif boleh melihat program kerja badan pelayanan mana pun,
    // sesuai permintaan agar pengurus bisa saling belajar.
    // Yang boleh mengubah hanya pengurus badan itu saat masih draf,
    // pembinanya, dan super user.

    match /programKerja/{id} {
      // Program kerja biasa boleh dilihat siapa saja yang aktif, supaya
      // pengurus bisa belajar dari badan pelayanan lain. Yang ditandai
      // rahasia hanya terbuka bagi unitnya sendiri, pembinanya, dan peran pusat.
      allow read: if aktif() && (resource == null || bolehLihat(resource.data.bp));

      // Bendahara dan ketua yang ditugaskan pada badan pelayanan struktural
      // menyusun program kerjanya sendiri seperti pengurus lain.
      allow create: if isSuper()
                    || (isPembina() && binaan(request.resource.data.bp))
                    || ((isPengurus() || isBendahara() || isKetua())
                        && request.resource.data.bp in bpSaya()
                        && request.resource.data.status == 'draf');

      allow update: if isSuper()
                    || (isPembina() && binaan(resource.data.bp))
                    || ((isPengurus() || isBendahara() || isKetua())
                        && resource.data.bp in bpSaya()
                        && resource.data.status in ['draf', 'dikembalikan']
                        && request.resource.data.status in ['draf', 'diajukan']);

      allow delete: if isSuper()
                    || ((isPengurus() || isBendahara() || isKetua())
                        && resource.data.bp in bpSaya()
                        && resource.data.status == 'draf');
    }

    /* ─────────── PBO ─────────── */
    // Pengurus hanya melihat miliknya sendiri. Verifikasi oleh bendahara.
    // Ketua Majelis Jemaat dipakai untuk dua hal: menyetujui PBO milik bendahara,
    // dan memberi izin khusus saat LPJ bulan sebelumnya belum masuk.

    match /pbo/{id} {
      allow read: if aktif() && (
        resource == null
        || pusat()
        || binaan(resource.data.bp)
      );

      // Pengajuan boleh dibuat pengurus maupun pembina, karena divisi seperti
      // Litbang dan Sarpen menjalankan programnya sendiri tanpa departemen.
      allow create: if isSuper()
                    || ((isPengurus() || isPembina() || isBendahara() || isKetua())
                        && (binaan(request.resource.data.bp) || request.resource.data.bp in bpSaya())
                        && request.resource.data.status in ['diajukan', 'diperiksaPembina']);

      // Verifikasi berjenjang: pembina memeriksa pengajuan departemen binaannya,
      // lalu bendahara memberi persetujuan akhir dan mencatat pencairan.
      allow update: if isSuper() || isBendahara() || isKetua()
                    || (isPembina() && binaan(resource.data.bp))
                    || ((isPengurus() || isPembina()) && binaan(resource.data.bp)
                        && resource.data.status in ['diajukan', 'dikembalikan']);

      allow delete: if isSuper()
                    || ((isPengurus() || isPembina()) && binaan(resource.data.bp)
                        && resource.data.status in ['diajukan', 'dikembalikan']);
    }

    /* ─────────── LPJ ─────────── */

    match /lpj/{id} {
      allow read: if aktif() && (
        resource == null
        || pusat()
        || binaan(resource.data.bp)
      );

      // LPJ disusun badan pelayanan sendiri, diperiksa pembina, lalu
      // disetujui bendahara. Bendahara dan ketua juga menyusun LPJ
      // untuk badan pelayanan struktural yang ditugaskan padanya.
      allow create: if isSuper()
                    || ((isPengurus() || isPembina() || isBendahara() || isKetua())
                        && request.resource.data.bp in bpSaya());

      // Penyusun boleh mengubah saat masih draf atau dikembalikan, dan boleh
      // mengirim bukti pengembalian setelah LPJ-nya disetujui bendahara.
      allow update: if isSuper() || isBendahara() || isKetua()
                    || (isPembina() && binaan(resource.data.bp))
                    || ((isPengurus() || isBendahara() || isKetua())
                        && resource.data.bp in bpSaya()
                        && resource.data.status in ['draf', 'dikembalikan', 'disetujui']);

      allow delete: if isSuper()
                    || ((isPengurus() || isBendahara() || isKetua())
                        && resource.data.bp in bpSaya()
                        && resource.data.status == 'draf');
    }

    /* ─────────── Keuangan gereja ─────────── */
    // Buku kas, jurnal, neraca, dan anggaran. Tertutup bagi pengurus.

    match /transaksi/{id} {
      allow read: if majelis();
      allow create, update: if isSuper() || isBendahara();
      allow delete: if isSuper();
    }

    match /rapb/{id} {
      allow read: if majelis();
      allow write: if isSuper() || isBendahara();
    }

    match /kewajiban/{id} {
      allow read: if majelis();
      allow write: if isSuper() || isBendahara();
    }

    /* ─────────── Jejak audit ─────────── */
    // Hanya bisa ditambah, tidak bisa diubah maupun dihapus oleh siapa pun.

    match /jejak/{id} {
      allow read: if majelis();
      allow create: if aktif();
      allow update, delete: if false;
    }

    /* ─────────── Sisanya ditolak ─────────── */

    match /{dokumen=**} {
      allow read, write: if false;
    }
  }
}
